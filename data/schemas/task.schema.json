{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "description": "失败发生时所在的流水线阶段",
          "enum": [
            "CREATED",
            "ROUTING",
            "ACCESSING",
            "FETCHING",
            "PROCESSING",
            "EXTRACTING",
            "VALIDATING",
            "INDEXING",
            "ANALYZING",
            "MAPPING",
            "GENERATING",
            "REVIEWING",
            "COMPLETED",
            "FAILED",
            "BLOCKED",
            "CANCELLED"
          ],
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "description": "机器可读失败码",
          "enum": [
            "success",
            "blocked",
            "access_restricted",
            "unavailable",
            "timeout",
            "rate_limited",
            "parse_failed",
            "extraction_failed",
            "validation_failed",
            "index_failed",
            "dependency_failed",
            "cancelled"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "code"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "RefPair": {
      "additionalProperties": false,
      "description": "通用引用：kind + ref_id，用于 task 的 input/output refs 等。",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "artifact",
            "source",
            "document",
            "chunk",
            "case",
            "style",
            "topic",
            "analysis",
            "mapping",
            "profile",
            "audit",
            "effect",
            "draft",
            "evidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "title": "RefPair",
      "type": "object"
    },
    "RetryInfo": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "default": 0,
          "description": "已重试次数",
          "maximum": 10,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "description": "最大重试次数（有限重试）",
          "maximum": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "last_error": {
          "default": "",
          "maxLength": 500,
          "title": "Last Error",
          "type": "string"
        }
      },
      "title": "RetryInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "16 态任务状态机契约。任务状态由确定性引擎管理，LLM 不持有任务状态。\n\n状态迁移表在 M7（core/task.py）实现；本契约只约束枚举与可恢复性字段。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "description": "契约版本；变更契约时按语义化版本递增",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "description": "创建时间（Python 托管；若显式给出必须带时区，如 +08:00）",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "description": "更新时间（Python 托管；若显式给出必须带时区）",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "task_id": {
      "description": "推荐前缀 task-",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "research",
        "writing",
        "review",
        "retro",
        "extraction",
        "import",
        "maintenance",
        "generic"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "status": {
      "default": "CREATED",
      "enum": [
        "CREATED",
        "ROUTING",
        "ACCESSING",
        "FETCHING",
        "PROCESSING",
        "EXTRACTING",
        "VALIDATING",
        "INDEXING",
        "ANALYZING",
        "MAPPING",
        "GENERATING",
        "REVIEWING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "progress": {
      "default": 0,
      "description": "0-100",
      "maximum": 100,
      "minimum": 0,
      "title": "Progress",
      "type": "integer"
    },
    "input_refs": {
      "items": {
        "$ref": "#/$defs/RefPair"
      },
      "maxItems": 50,
      "title": "Input Refs",
      "type": "array"
    },
    "output_refs": {
      "items": {
        "$ref": "#/$defs/RefPair"
      },
      "maxItems": 50,
      "title": "Output Refs",
      "type": "array"
    },
    "retry": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetryInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_refs": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "恢复锚点：kind → id 列表（resume 依据）",
      "maxProperties": 20,
      "title": "Context Refs",
      "type": "object"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Task Id"
    },
    "resumable": {
      "default": true,
      "description": "是否可恢复（中断后 resume 的依据）",
      "title": "Resumable",
      "type": "boolean"
    }
  },
  "required": [
    "task_id",
    "task_type"
  ],
  "title": "TaskRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
