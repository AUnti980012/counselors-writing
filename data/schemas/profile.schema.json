{
  "$defs": {
    "ProfileProvenance": {
      "additionalProperties": false,
      "description": "画像字段级溯源：谁在什么时候基于什么证据写下这个字段。",
      "properties": {
        "field": {
          "enum": [
            "school_name",
            "school_type",
            "student_profile",
            "common_topics",
            "sensitive_points",
            "title_style_preference"
          ],
          "title": "Field",
          "type": "string"
        },
        "fact_type": {
          "enum": [
            "documented_fact",
            "source_claim",
            "ai_inference",
            "derived_pattern",
            "recommendation"
          ],
          "title": "Fact Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Evidence Ids",
          "type": "array"
        },
        "basis": {
          "default": "",
          "maxLength": 1000,
          "title": "Basis",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "field",
        "fact_type"
      ],
      "title": "ProfileProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "学校画像契约：7 键白名单（对应 V1 school.json），extra=forbid 拒绝未知键。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "description": "契约版本；变更契约时按语义化版本递增",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "description": "创建时间（Python 托管；若显式给出必须带时区，如 +08:00）",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "description": "更新时间（Python 托管；若显式给出必须带时区）",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "profile_id": {
      "description": "推荐前缀 pro-",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Profile Id",
      "type": "string"
    },
    "school_name": {
      "default": "",
      "maxLength": 200,
      "title": "School Name",
      "type": "string"
    },
    "school_type": {
      "default": "other",
      "enum": [
        "university",
        "college",
        "vocational",
        "high_school",
        "other"
      ],
      "title": "School Type",
      "type": "string"
    },
    "student_profile": {
      "default": "",
      "maxLength": 3000,
      "title": "Student Profile",
      "type": "string"
    },
    "common_topics": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Common Topics",
      "type": "array"
    },
    "sensitive_points": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Sensitive Points",
      "type": "array"
    },
    "title_style_preference": {
      "default": "",
      "maxLength": 1000,
      "title": "Title Style Preference",
      "type": "string"
    },
    "provenance": {
      "description": "字段级溯源（事实带证据，推断带依据）",
      "items": {
        "$ref": "#/$defs/ProfileProvenance"
      },
      "maxItems": 20,
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "profile_id"
  ],
  "title": "SchoolProfileRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
