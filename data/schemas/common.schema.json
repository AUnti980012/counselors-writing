      "additionalProperties": false,
      "description": "一次热点筛查运行的结果（独立、可追溯的处理结果，与原始快照分离存储）。\n\nreview_id 由被审核快照 items 的内容哈希稳定推导，用于复用检测：同快照复用\n已有有效审核，快照内容变化则生成新 review_id，绝不覆盖旧审核。",
      "properties": {
        "schema_version": {
          "default": "1.2.0",
          "description": "契约版本；变更契约时按语义化版本递增",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "review_id": {
          "description": "推荐前缀 hrv-（按被审核快照内容哈希稳定）",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Review Id",
          "type": "string"
        },
        "snapshot_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
              "type": "string"
            },
