          "maxLength": 128,
          "title": "Snapshot Content Hash",
          "type": "string"
        },
        "reviewed_at": {
          "description": "本次筛查运行时间",
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/HotReviewItem"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        },
        "counts": {
