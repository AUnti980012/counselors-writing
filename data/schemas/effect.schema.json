{
  "$defs": {
    "EffectDimension": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "note": {
          "default": "",
          "maxLength": 1000,
          "title": "Note",
          "type": "string"
        }
      },
      "title": "EffectDimension",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "传播效果/复盘契约：V1 案例 16 字段里的 effect/retro 独立成表，不回写 Case。",
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "description": "契约版本；变更契约时按语义化版本递增",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "description": "创建时间（Python 托管；若显式给出必须带时区，如 +08:00）",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "description": "更新时间（Python 托管；若显式给出必须带时区）",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "effect_id": {
      "description": "推荐前缀 eff-",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Effect Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "draft_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Draft Id"
    },
    "dimensions": {
      "additionalProperties": {
        "$ref": "#/$defs/EffectDimension"
      },
      "description": "五维度：title/opening/paragraph_resonance/sublimation/communication_data",
      "maxProperties": 5,
      "title": "Dimensions",
      "type": "object"
    },
    "feedback": {
      "default": "",
      "description": "辅导员反馈/传播数据",
      "maxLength": 2000,
      "title": "Feedback",
      "type": "string"
    },
    "retro": {
      "default": "",
      "description": "复盘结论",
      "maxLength": 3000,
      "title": "Retro",
      "type": "string"
    },
    "reusable_patterns": {
      "description": "可复用经验（回写风格库/案例库的依据，单条 ≤1000 字符）",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Reusable Patterns",
      "type": "array"
    }
  },
  "required": [
    "effect_id",
    "case_id"
  ],
  "title": "EffectRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
